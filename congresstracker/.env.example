# CongressTracker environment variables
# Copy to `.env.local` and fill in. NEVER commit real values.

# --- Congress.gov API (free key from https://api.data.gov/signup/) ---
# Rate limit ~5,000 requests/day per key. Ingestion pages incrementally and
# syncs by updated_at rather than full refetches.
CONGRESS_API_KEY=

# --- Supabase ---
# Public, read-only on the client. Safe to expose to the browser. The GitHub
# Pages static export (`npm run build:static`) reads these at build time and
# bakes the anon key into the bundle so the static site fetches live data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — used ONLY by ingestion jobs.
# Must never be exposed to the browser or committed.
SUPABASE_SERVICE_ROLE_KEY=

# --- Deployment (optional) ---
# Secret guarding the /api/cron/sync endpoint. Set this in Vercel and it will be
# sent automatically as `Authorization: Bearer <value>` on scheduled cron runs.
# A long random string (e.g. `openssl rand -hex 32`).
CRON_SECRET=

# Override the Congress in session if auto-detection ever needs it (e.g. 119).
# CURRENT_CONGRESS=119
