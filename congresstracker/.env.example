# CongressTracker environment variables
# Copy to `.env.local` and fill in. NEVER commit real values.

# --- Congress.gov API (free key from https://api.data.gov/signup/) ---
# Rate limit ~5,000 requests/day per key. Ingestion pages incrementally and
# syncs by updated_at rather than full refetches.
CONGRESS_API_KEY=

# --- Supabase ---
# Public, read-only on the client. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — used ONLY by ingestion jobs.
# Must never be exposed to the browser or committed.
SUPABASE_SERVICE_ROLE_KEY=
