# Supabase (Project Settings → API). Local values come from `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used exclusively by src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (anti-spam on public forms)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (staff notification emails)
RESEND_API_KEY=
STAFF_NOTIFY_EMAILS=

# Public site URL, no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: DeepL API Free, for the admin "Translate from Arabic" button
DEEPL_API_KEY=

# Static preview only (GitHub Pages sub-path), e.g. /hussainkanaan/ngo-platform
NEXT_PUBLIC_BASE_PATH=
