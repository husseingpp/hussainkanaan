{
  "expo": {
    "name": "Golden Hour Explorer",
    "slug": "golden-hour-explorer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "goldenhourexplorer",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.husseingpp.goldenhourexplorer",
      "supportsTablet": true
    },
    "android": {
      "package": "com.husseingpp.goldenhourexplorer",
      "adaptiveIcon": {
        "backgroundColor": "#0c0a14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Golden Hour Explorer to use your location to find nearby spots and capture new ones."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Golden Hour Explorer to access your photos to attach images to a spot."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0c0a14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    }
  }
}
