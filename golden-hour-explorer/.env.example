# Golden Hour Explorer — environment
# Copy to .env. All EXPO_PUBLIC_* vars are inlined into the app at build time.
# The Supabase publishable (anon) key is safe to ship — Row Level Security
# governs access. Sensible defaults are baked into src/lib/config.ts, so the
# app runs against the demo project even without this file.

EXPO_PUBLIC_SUPABASE_URL=https://enaiwztlekfvcmsblltd.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_QKwZDZCgcI_l7CeBc5Pf9g_M6bViift

# Optional: a MapTiler key for a nicer dark basemap. Without it the app uses
# MapLibre's keyless demo style.
# EXPO_PUBLIC_MAPTILER_KEY=your_maptiler_key

# Optional: override the full map style URL.
# EXPO_PUBLIC_MAP_STYLE=https://demotiles.maplibre.org/style.json
